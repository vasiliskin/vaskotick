{
  "name": "vaskotick",
  "version": "1.2.0",
  "description": "VaskoTick — учёт рабочего времени: проекты, задачи, таймер, отчёты",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/start.js",
    "dist": "node scripts/build.js"
  },
  "build": {
    "appId": "com.worktime.tracker",
    "productName": "Worktime Tracker",
    "files": [
      "main.js",
      "preload.js",
      "start.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "WorktimeTracker-1.0.0-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Worktime Tracker",
      "artifactName": "WorktimeTracker-1.0.0-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasiliskin/vaskotick.git"
  }
}